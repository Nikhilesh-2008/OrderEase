clinic <- data.frame(
Month = c("Jan", "Feb", "Mar", "Apr", "May", "Jun"),
Visits = c(820, 910, 875, 960, 1040, 990),
Target = c(850, 900, 900, 930, 1000, 1020),
Last_Year = c(760, 830, 800, 870, 920, 940)
)
clinic <- clinic %>%
mutate(
Proportion = Visits / sum(Visits),
Percentage = Proportion * 100
)
library(dplyr)
clinic <- data.frame(
Month = c("Jan", "Feb", "Mar", "Apr", "May", "Jun"),
Visits = c(820, 910, 875, 960, 1040, 990),
Target = c(850, 900, 900, 930, 1000, 1020),
Last_Year = c(760, 830, 800, 870, 920, 940)
)
clinic <- clinic %>%
mutate(
Proportion = Visits / sum(Visits),
Percentage = Proportion * 100
)
print(clinic[, c("Month", "Visits", "Proportion", "Percentage")])
ggplot(clinic, aes(x = Month, y = Percentage)) +
geom_col(fill = "steelblue") +
labs(title = "Monthly Clinic Visits: Percentage Contribution",
x = "Month", y = "Percentage of Total Visits (%)")
library(dplyr)
library(ggplot2)
clinic <- data.frame(
Month = c("Jan", "Feb", "Mar", "Apr", "May", "Jun"),
Visits = c(820, 910, 875, 960, 1040, 990),
Target = c(850, 900, 900, 930, 1000, 1020),
Last_Year = c(760, 830, 800, 870, 920, 940)
)
clinic <- clinic %>%
mutate(
Proportion = Visits / sum(Visits),
Percentage = Proportion * 100
)
print(clinic[, c("Month", "Visits", "Proportion", "Percentage")])
ggplot(clinic, aes(x = Month, y = Percentage)) +
geom_col(fill = "steelblue") +
labs(title = "Monthly Clinic Visits: Percentage Contribution",
x = "Month", y = "Percentage of Total Visits (%)")
library(dplyr)
library(ggplot2)
clinic <- clinic %>%
mutate(
Growth = Visits - Last_Year,
Growth_Percentage = (Visits - Last_Year) / Last_Year * 100
)
print(clinic[, c("Month", "Visits", "Last_Year", "Growth", "Growth_Percentage")])
ggplot(clinic, aes(x = Month)) +
geom_line(aes(y = Visits, color = "Current Year"), group = 1) +
geom_point(aes(y = Visits, color = "Current Year")) +
geom_line(aes(y = Last_Year, color = "Previous Year"), group = 1) +
geom_point(aes(y = Last_Year, color = "Previous Year")) +
labs(title = "Current vs Previous-Year Clinic Visits",
x = "Month", y = "Number of Visits", color = "Period")
library(dplyr)
library(ggplot2)
clinic <- clinic %>%
mutate(
Gap = Visits - Target,
Achievement_Percentage = Visits / Target * 100,
Status = ifelse(Visits >= Target, "Target Achieved", "Below Target")
)
ggplot(clinic, aes(x = Month)) +
geom_col(aes(y = Visits, fill = "Actual Visits"),
position = position_dodge(width = 0.8), width = 0.35) +
geom_col(aes(y = Target, fill = "Target Visits"),
position = position_dodge(width = 0.8), width = 0.35) +
labs(title = "Actual Clinic Visits vs Target",
x = "Month", y = "Number of Visits", fill = "Measure")clinic <- clinic %>%
