library(ggplot2)
library(dplyr)
process <- data.frame(
Sample_No = 1:24,
Package_Weight = c(500.4, 499.7, 501.2, 500.8, 499.5, 500.1,
501.5, 498.9, 500.6, 499.8, 500.3, 501.0, 499.4, 500.7,
498.8, 501.3, 500.0, 499.6, 500.9, 501.1, 499.2, 500.5, 498.7, 501.4)
)
training <- data.frame(
Training_Hours = 1:8,
Defects = c(18, 16, 15, 12, 10, 8, 7, 5)
)
channel <- data.frame(
Month = c("Jan", "Jan", "Feb", "Feb", "Mar", "Mar", "Apr", "Apr"),
Channel = c("Online", "Walk-in", "Online", "Walk-in", "Online", "Walk-in", "Online", "Walk-in"),
Requests = c(180, 140, 210, 155, 195, 160, 235, 175)
)
model <- lm(Defects ~ Training_Hours, data = training)
summary(model)
ggplot(training, aes(x = Training_Hours, y = Defects)) +
geom_point(size = 3) +
geom_smooth(method = "lm", se = FALSE, color = "red") +
labs(title = "Regression: Training Hours and Defects",
x = "Training Hours", y = "Number of Defects")
library(ggplot2)
library(dplyr)
energy <- data.frame(
Month_No = 1:12,
Month = c("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"),
Consumption_kWh = c(4200, 3950, 4100, 4350, 4700, 5100, 5450, 5300, 4850, 4500, 4300, 4600),
Peak_Demand = c(210, 198, 205, 218, 235, 252, 270, 264, 243, 225, 215, 230),
Budget_kWh = c(4300, 4100, 4200, 4400, 4600, 5000, 5300, 5200, 4900, 4600, 4400, 4500)
)
ggplot(energy, aes(x = Month, y = Consumption_kWh, group = 1)) +
geom_line(color = "blue", linewidth = 1) +
geom_point(size = 3) +
labs(title = "Monthly Electricity Consumption",
x = "Month", y = "Consumption (kWh)")
library(ggplot2)
library(dplyr)
energy <- data.frame(
Month_No = 1:12,
Month = c("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"),
Consumption_kWh = c(4200, 3950, 4100, 4350, 4700, 5100, 5450, 5300, 4850, 4500, 4300, 4600),
Peak_Demand = c(210, 198, 205, 218, 235, 252, 270, 264, 243, 225, 215, 230),
Budget_kWh = c(4300, 4100, 4200, 4400, 4600, 5000, 5300, 5200, 4900, 4600, 4400, 4500)
)
energy <- energy %>%
mutate(Budget_Used_Percentage = Consumption_kWh / Budget_kWh * 100)
scale_factor <- 50
ggplot(energy, aes(x = Month_No)) +
geom_line(aes(y = Consumption_kWh, color = "Consumption (kWh)"),
linewidth = 1) +
geom_point(aes(y = Consumption_kWh, color = "Consumption (kWh)")) +
geom_line(aes(y = Budget_Used_Percentage * scale_factor,
color = "Budget Used (%)"), linewidth = 1) +
geom_point(aes(y = Budget_Used_Percentage * scale_factor,
color = "Budget Used (%)")) +
scale_x_continuous(breaks = 1:12, labels = energy$Month) +
scale_y_continuous(name = "Consumption (kWh)",
sec.axis = sec_axis(~ . / scale_factor,
name = "Budget Used (%)")) +
labs(title = "Electricity Consumption and Budget Used",
x = "Month", color = "Measure")
library(ggplot2)
library(dplyr)
energy <- data.frame(
Month_No = 1:12,
Month = c("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"),
Consumption_kWh = c(4200, 3950, 4100, 4350, 4700, 5100, 5450, 5300, 4850, 4500, 4300, 4600),
Peak_Demand = c(210, 198, 205, 218, 235, 252, 270, 264, 243, 225, 215, 230),
Budget_kWh = c(4300, 4100, 4200, 4400, 4600, 5000, 5300, 5200, 4900, 4600, 4400, 4500)
)
ggplot(energy, aes(x = Month_No, y = Consumption_kWh)) +
geom_point(size = 3, color = "darkgreen") +
geom_smooth(method = "lm", se = FALSE, color = "red") +
scale_x_continuous(breaks = 1:12, labels = energy$Month) +
labs(title = "Electricity Consumption Trend Over Time",
x = "Month", y = "Consumption (kWh)")
