library(ggplot2)
library(dplyr)
delivery <- data.frame(
Package_ID = 1:30,
Delivery_Minutes = c(28.4, 31.2, 29.7, 33.1, 30.5, 27.9, 32.4, 29.1, 31.8, 30.2,
34.0, 28.8, 29.9, 32.7, 30.8, 31.0, 27.5, 33.4, 29.4, 30.1,
32.0, 28.6, 31.5, 30.6, 29.3, 34.2, 27.8, 31.1, 30.0, 32.3)
)
mean_value <- mean(delivery$Delivery_Minutes)
median_value <- median(delivery$Delivery_Minutes)
sd_value <- sd(delivery$Delivery_Minutes)
range_value <- range(delivery$Delivery_Minutes)
cat("Mean:", mean_value, "\n")
cat("Median:", median_value, "\n")
cat("Standard deviation:", sd_value, "\n")
cat("Minimum:", range_value[1], "\n")
cat("Maximum:", range_value[2], "\n")
cat("Range:", diff(range_value), "\n")
ggplot(delivery, aes(x = Delivery_Minutes)) +
geom_boxplot(fill = "lightblue") +
labs(title = "Variation in Delivery Times",
x = "Delivery Time (minutes)", y = "")
library(ggplot2)
library(dplyr)
delivery <- data.frame(
Package_ID = 1:30,
Delivery_Minutes = c(28.4, 31.2, 29.7, 33.1, 30.5, 27.9, 32.4, 29.1, 31.8, 30.2,
34.0, 28.8, 29.9, 32.7, 30.8, 31.0, 27.5, 33.4, 29.4, 30.1,
32.0, 28.6, 31.5, 30.6, 29.3, 34.2, 27.8, 31.1, 30.0, 32.3)
)
mean_value <- mean(delivery$Delivery_Minutes)
sd_value <- sd(delivery$Delivery_Minutes)
ggplot(delivery, aes(x = Delivery_Minutes)) +
geom_histogram(aes(y = after_stat(density)), bins = 9,
fill = "lightblue", color = "black") +
stat_function(fun = dnorm,
args = list(mean = mean_value, sd = sd_value),
color = "red", linewidth = 1) +
labs(title = "Delivery Time Distribution with Normal Curve",
x = "Delivery Time (minutes)", y = "Density")
library(ggplot2)
library(dplyr)
process <- data.frame(
Sample_No = 1:24,
Package_Weight = c(500.4, 499.7, 501.2, 500.8, 499.5, 500.1,
501.5, 498.9, 500.6, 499.8, 500.3, 501.0, 499.4, 500.7,
498.8, 501.3, 500.0, 499.6, 500.9, 501.1, 499.2, 500.5, 498.7, 501.4)
)
training <- data.frame(
Training_Hours = 1:8,
Defects = c(18, 16, 15, 12, 10, 8, 7, 5)
)
channel <- data.frame(
Month = c("Jan", "Jan", "Feb", "Feb", "Mar", "Mar", "Apr", "Apr"),
Channel = c("Online", "Walk-in", "Online", "Walk-in", "Online", "Walk-in", "Online", "Walk-in"),
Requests = c(180, 140, 210, 155, 195, 160, 235, 175)
)
center_line <- mean(process$Package_Weight)
process_sd <- sd(process$Package_Weight)
UCL <- center_line + 3 * process_sd
LCL <- center_line - 3 * process_sd
process <- process %>%
mutate(Status = ifelse(Package_Weight > UCL | Package_Weight < LCL,
"Outside Limits", "Within Limits"))
cat("Center line:", center_line, "\n")
cat("UCL:", UCL, "\n")
cat("LCL:", LCL, "\n")
ggplot(process, aes(x = Sample_No, y = Package_Weight)) +
geom_line() +
geom_point(aes(color = Status), size = 3) +
geom_hline(yintercept = center_line) +
geom_hline(yintercept = UCL, linetype = "dashed", color = "red") +
geom_hline(yintercept = LCL, linetype = "dashed", color = "red") +
labs(title = "Package Weight Control Chart",
x = "Sample Number", y = "Package Weight (g)", color = "Status")
